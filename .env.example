# Le frontend reste mock-first (localStorage) tant que la migration écran
# par écran n'a pas commencé — voir ROADMAP-backend-et-mobile.md.
# Prisma est initialisé (prisma/schema.prisma) pour démarrer le backend :

# Chaîne de connexion PostgreSQL — base réelle : Supabase. DATABASE_URL =
# Transaction Pooler (port 6543, ?pgbouncer=true) pour le runtime de l'app.
# DIRECT_URL = Session Pooler (port 5432) requis pour `prisma db pull` /
# `migrate` (le Transaction Pooler ne supporte pas les prepared statements
# dont le CLI Prisma a besoin — la commande reste bloquée sans erreur sinon).
# La connexion directe (5432 sur db.<ref>.supabase.co) est IPv6-only et
# souvent injoignable.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres"

# URL + clé publique du projet (dashboard Supabase > Project Settings > API,
# ou via l'outil MCP get_project_url / get_publishable_keys). La clé
# publique est safe côté client — ne jamais y mettre la service_role key.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Clé secrète (contourne le RLS) — dashboard Supabase > Project Settings >
# API Keys > "service_role". Jamais NEXT_PUBLIC_*, jamais exposée au client.
# Utilisée uniquement côté serveur pour le stockage fichiers dédié
# (src/lib/server/storage.ts) : téléversement des images/documents et
# génération des URL signées pour le bucket privé kyc-documents.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Accès à l'interface administrateur sécurisée (/tourney-control). Jamais
# NEXT_PUBLIC_*, jamais commités en dur (cf. src/lib/server/adminAuth.ts,
# qui échoue fermé — accès admin bloqué — si l'une des trois manque).
TOURNEY_ADMIN_IDENTIFIANT="..."
TOURNEY_ADMIN_MOT_DE_PASSE="..."
TOURNEY_ADMIN_PIN="123456"
